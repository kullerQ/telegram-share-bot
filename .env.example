# Token from @BotFather after /newbot
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Chat where the bot uploads media to obtain file_id (required for clean inline UX).
# Use YOUR private user id (or a private channel only you can read). Never a shared group.
# Get your id from @userinfobot or by messaging the bot after /start.
STORAGE_CHAT_ID=123456789

# Access control (required): either allowlist users OR explicitly opt into public mode.
# Comma-separated Telegram user ids allowed to use the bot.
ALLOWED_USER_IDS=123456789
# Set to true ONLY if you intentionally want anyone to use the bot as a public downloader.
# ALLOW_PUBLIC=false

# Optional media host allowlist (defaults to YouTube/X/Instagram/TikTok).
# Use * to allow any http(s) host (not recommended).
# ALLOWED_MEDIA_HOSTS=youtube.com,youtu.be,x.com,twitter.com,instagram.com,tiktok.com
# ALLOWED_MEDIA_HOSTS=*

# Optional limits, logging, and cache settings (defaults shown)
# MAX_FILE_BYTES=47185920
# DOWNLOAD_TIMEOUT_SECONDS=90
# UPLOAD_TIMEOUT_SECONDS=180
# CACHE_DB_PATH=downloads/media_cache.db
# LOG_FILE=logs/bot.log
# Set to true if you want to delete messages from storage chat (NOT recommended with caching, as Telegram may garbage collect file_ids)
# DELETE_STORAGE_MESSAGES=true
# Max parallel downloads across all users (default 3)
# MAX_CONCURRENT_DOWNLOADS=3
# Max in-flight downloads per user (default 3)
# MAX_DOWNLOADS_PER_USER=3
