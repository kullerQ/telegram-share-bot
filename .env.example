# Token from @BotFather after /newbot
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Chat where the bot uploads media to obtain file_id (required for clean inline UX).
# Use your own user id, or a private channel/group the bot can post to.
# Get your id from @userinfobot or by messaging the bot after /start (it prints chat id).
STORAGE_CHAT_ID=123456789

# Optional limits (defaults shown)
# MAX_FILE_BYTES=47185920
# DOWNLOAD_TIMEOUT_SECONDS=90
