# Token from @BotFather after /newbot
BOT_TOKEN=123456:ABC-DEF_your_token_here

# Chat where the bot uploads media to obtain file_id (required for clean inline UX).
# Use YOUR private user id (or a private channel only you can read). Never a shared group.
# Get your id from @userinfobot or by messaging the bot after /start.
STORAGE_CHAT_ID=123456789

# Access control (required): either allowlist users OR explicitly opt into public mode.
# Comma-separated Telegram user ids allowed to use the bot.
ALLOWED_USER_IDS=123456789
# Set to true ONLY if you intentionally want anyone to use the bot as a public downloader.
# ALLOW_PUBLIC=false
# Allow STORAGE_CHAT_ID to be a group/channel (not recommended).
# ALLOW_SHARED_STORAGE=false

# Optional media host allowlist (defaults to YouTube/X/Instagram/TikTok/Reddit/Facebook).
# Use * to allow any http(s) host (not recommended).
# ALLOWED_MEDIA_HOSTS=youtube.com,tiktok.com,reddit.com,facebook.com
# ALLOWED_MEDIA_HOSTS=*

# Require HTTPS for user and extracted media URLs (default true). Set false to allow http://
# HTTPS_ONLY=true

# Optional limits, logging, and cache settings (defaults shown)
# GHCR image tag to deploy (pin a release such as 1.0.0 for repeatable deployments)
# BOT_IMAGE_TAG=latest
# MAX_FILE_BYTES=47185920
# DOWNLOAD_TIMEOUT_SECONDS=120
# UPLOAD_TIMEOUT_SECONDS=180
# CACHE_DB_PATH=downloads/media_cache.db
# LOG_FILE=logs/bot.log
# Set to true if you want to delete messages from storage chat (Have impact on caching, as Telegram may garbage collect file_ids)
# DELETE_STORAGE_MESSAGES=true
# Max parallel downloads across all users (default 6; 0 = unlimited)
# MAX_CONCURRENT_DOWNLOADS=6
# Max in-flight requests per user (default 3; 0 = unlimited)
# MAX_DOWNLOADS_PER_USER=3
# Max download requests per user in a rolling 60-second window (default 10; 0 = unlimited).
# Rejected requests due to cooldown or active-download limits also count toward this limit.
# MAX_DOWNLOADS_PER_MINUTE=10
# Max length of new full media, including audio (default 1800 = 30 min; 0 disables).
# Short YouTube clips from longer sources are still allowed.
# MAX_MEDIA_DURATION_SECONDS=1800
# Minimum seconds between download starts per user (default 2; 0 disables)
# DOWNLOAD_COOLDOWN_SECONDS=2

# Inline result logos need a public HTTPS URL. The default uses this repository's
# main branch after the logo files are merged. For local testing before a push,
# use the unpadded public originals from the credited icon pack to test
# thumbnail availability. The padded appearance is available after merge:
# PLATFORM_LOGO_BASE_URL=upstream
# You may also set your own public HTTPS directory URL, or an empty value to
# show text-only inline results.
# PLATFORM_LOGO_BASE_URL=https://example.com/platforms

# Caption attached to sent media:
#   media  — use the downloaded media title (default)
#   custom — only a user caption after the URL (space-separated); none if omitted
#   off    — never attach a caption
# CAPTION_MODE=media
# Example with custom: @YourBot https://youtube.com/watch?v=… my caption here
# Note: custom captions are plain text only, truncated to 1024 chars, never cached,
# and never written to STORAGE_CHAT_ID. On public bots, users can put arbitrary text
# on media they send — keep ALLOW_PUBLIC=false unless you accept that.

# TikTok photo-post (slideshow) compilation:
# Preferred per-image display duration in milliseconds (default 2500 = 2.5s).
# SLIDESHOW_SLIDE_MS=2500
# Max images to include from a photo post (default 35).
# SLIDESHOW_MAX_IMAGES=35
# How image looping relates to audio length:
#   true  — video matches the full audio; images loop to fill it (default)
#   false — one pass through the images, then trim the audio
#           (a single-image post still uses the full audio)
# SLIDESHOW_IMAGES_LOOP=true
